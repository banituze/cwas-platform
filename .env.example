# --- core ---
SECRET_KEY=                      # long random string; if empty a key is generated once in instance/secret.key
DATABASE_URL=                    # postgresql://user:pass@host:5432/db ; empty means SQLite in instance/cwas.db


# --- first administrator (used only when no admin exists yet) ---
ADMIN_EMAIL=info@winebald.tech
ADMIN_PASSWORD=                  # set before the first start; the admin must still change it at first sign-in

# --- demo data and simulator ---
SEED_DEMO=1                      # demo coordinator, households and history. Default: on locally, off in production
SIMULATOR_PUBLIC=1               # 1 = anyone can use the device lab. Default: on locally, signed-in users only in production

# --- Africa's Talking (USSD + SMS) ---
SMS_ENABLED=0                    # 1 sends real SMS
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=CWAS                # alphanumeric sender, used in sandbox and live; retried without it if rejected
AT_USSD_CODE="*384*9411#"       # quoted: in a .env file an unquoted # can start a comment
AT_SHORTCODE=7380
AT_WEBHOOK_TOKEN=                # random string; add ?token=... to every callback URL you register

# --- mobile money ---
PAYMENT_MODE=                    # simulation posts deposits at once (default locally); live keeps them pending until confirmed (default in production)
PAYMENT_WEBHOOK_SECRET=          # shared secret for HMAC-SHA256 signed confirmations at /webhooks/payments/<orange|airtel>

# --- password reset email (optional; SMS is used when the account has a phone) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cwas.winebald.tech

# Search engines and link previews: the public address of the site
SITE_URL=https://winebald.tech
# Where security researchers report vulnerabilities (/.well-known/security.txt); defaults to ADMIN_EMAIL
SECURITY_CONTACT=security@winebald.tech